#!/usr/bin/env bash
#   grid  –  spawn an N×M tiled terminal grid in Hyprland
#   usage:  grid  [cols] [rows]  [cmd]
#   default: 3×3 with alacritty
#
#   Always splits the leftmost/topmost window. After each exec+resize,
#   focus returns to position 0 — no navigation needed.
#   No floating.  Runs on current (must be empty) workspace.

[[ $1 == --help || $1 == -h ]] && {
    cat <<'EOF'
Usage: grid [COLS] [ROWS] [CMD]

Spawn a COLS × ROWS grid of tiled terminal windows in Hyprland.
Windows are regular tiled — keyboard navigation/resize works.

Arguments:
  COLS  Columns (default: 3)    ROWS  Rows (default: 3)
  CMD   Terminal command (default: alacritty)

Examples:  grid | grid 5 2 foot | grid 4 3 "alacritty -e htop"
EOF
    exit 0
}

COLS=${1:-3}; ROWS=${2:-3}; CMD=${3:-alacritty}
S=0.15

die()  { echo "grid: $*" >&2; exit 1; }
require_positive_int() { [[ $2 =~ ^[1-9][0-9]*$ ]] || die "$1 must be a positive integer"; }
require_positive_int cols "$COLS"; require_positive_int rows "$ROWS"

adj() {
    local dim=$1 L=$2 R=$3 dpct
    dpct=$(awk -v L="$L" -v R="$R" 'BEGIN{printf "%.0f", (2*R/(L+R)-1)*100}')
    if (( $(awk -v d="$dpct" 'BEGIN{print (d<-0.5?1:0)}') )); then
        ((dim==0)) && hyprctl dispatch resizeactive "${dpct}%" 0 \
                    || hyprctl dispatch resizeactive 0 "${dpct}%"
    fi
}

build_dim() {
    local N=$1 dim=$2 presel
    ((dim==0)) && presel=r || presel=d

    for ((c=2; c<=N; c++)); do
        local L=$((N - c + 1)) R=1
        hyprctl dispatch layoutmsg "preselect $presel"; sleep "$S"
        hyprctl dispatch exec "$CMD"; sleep "$S"
        adj "$dim" "$L" "$R"; sleep "$S"
    done
}

# workspace check: abort if non-floating windows on current workspace
WS=$(hyprctl -j activeworkspace | jq -r '.id')
TILED=$(hyprctl -j clients | jq -r '[.[] | select(.workspace.id == '$WS' and .floating == false)] | length')
if (( TILED > 0 )); then
    die "workspace $WS has $TILED tiled windows — run on an empty workspace"
fi

hyprctl keyword dwindle:force_split 2
hyprctl keyword dwindle:preserve_split true
hyprctl keyword dwindle:default_split_ratio 1
hyprctl keyword input:follow_mouse 0

# seed + build columns, then rows
hyprctl dispatch exec "$CMD"; sleep "$S"
build_dim "$COLS" 0

for ((col=0; col<COLS; col++)); do
    ((ROWS>1)) && build_dim "$ROWS" 1
    ((col+1<COLS)) && { hyprctl dispatch movefocus r; sleep "$S"; }
done

hyprctl keyword input:follow_mouse 1
