#!/usr/bin/env bash
#   grid-ssh – spawn one SSH terminal per host in a balanced grid
#   usage:  grid-ssh host1 host2 …
#
#   Hyprland 0.56 (Lua config).  Same Lua dispatch/eval API as `grid`, same
#   equal-grid build: ROWS full-width bands, then COLS columns inside each band.
#   Speed scheme identical to `grid`: animations off for the build, no fixed
#   sleeps, adaptive waits for window map + geometry stability.
#
#   Host i is placed at visual row-major cell (i / COLS, i % COLS) — top-left
#   first.  Cells beyond the host count get a plain terminal.
#   Grid dimensions auto-chosen to stay close to 16:9.

TERM=alacritty
TARGET_RATIO=1.7777778     # 16/9

HOSTS=("$@"); N=${#HOSTS[@]}

[[ $1 == --help || $1 == -h || $N -eq 0 ]] && {
    cat <<'EOF'
Usage: grid-ssh HOST...

Spawn one tiled alacritty terminal per host, each running an SSH session.
Grid dimensions chosen automatically to stay close to 16:9 while
minimizing empty panes.  Empty panes get a plain terminal.
Hosts are placed top-left to bottom-right, left to right.

Examples:
  grid-ssh web1 web2 web3
  grid-ssh 192.168.1.10 192.168.1.11
EOF
    ((N==0)) && exit 1; exit 0
}

lua_str() { local s=$1; s=${s//\\/\\\\}; s=${s//\"/\\\"}; printf '"%s"' "$s"; }
dsp() { hyprctl dispatch "$1" >/dev/null; }

lm()  { dsp "hl.dsp.layout($(lua_str "$1"))"; }
fa()  { dsp "hl.dsp.focus({ window = \"address:$1\" })"; }
rr()  { dsp "hl.dsp.window.resize({ x = $1, y = $2, relative = true })"; }
# exec the current per-cell command ($cur) — runs through bash -c via exec_cmd
ex()  { dsp "hl.dsp.exec_cmd($(lua_str "$cur"))"; }

WS=$(hyprctl -j activeworkspace | jq -r '.id')
cnt() { hyprctl -j clients | jq "[.[]|select(.workspace.id==$WS)]|length"; }
act() { hyprctl -j activewindow | jq -r '"\(.size[0]) \(.size[1]) \(.address)"'; }

# ---- choose COLS × ROWS ----
best_diff=999999; best_unused=999999; ROWS=1; COLS=$N
for ((rows=1; rows<=N; rows++)); do
    cols=$(( (N + rows - 1) / rows ))
    unused=$(( rows*cols - N ))
    ratio_cr=$(awk -v c="$cols" -v r="$rows" 'BEGIN{print c/r}')
    diff=$(awk -v a="$ratio_cr" -v b="$TARGET_RATIO" 'BEGIN{print (a>b?a-b:b-a)}')
    # prefer fewer unused cells, then closer to 16:9
    if (( unused < best_unused )) || \
       { (( unused == best_unused )) && (( $(awk -v d="$diff" -v b="$best_diff" 'BEGIN{print (d < b - 0.000001 ? 1 : 0)}') )); }; then
        best_diff=$diff; best_unused=$unused; ROWS=$rows; COLS=$cols
    fi
done

# ---- workspace check ----
TILED=$(hyprctl -j clients | jq -r '[.[] | select(.workspace.id == '$WS' and .floating == false)] | length')
if (( TILED > 0 )); then
    echo "grid-ssh: workspace $WS has $TILED tiled windows — run on empty workspace" >&2
    exit 1
fi

# command for the cell with row-major index hi ("" past the host list = plain)
cell_cmd() {
    local hi=$1
    if (( hi < N )); then
        printf '%s --command ssh %s' "$TERM" "${HOSTS[$hi]}"
    else
        printf '%s' "$TERM"
    fi
}

# ---- creation-order cell list -> per-step command array ----
# Split with remaining count L puts the new window at visual index L of that
# dimension.  band split r -> row ROWS-r+1 ; column split c -> col COLS-c+1.
# Creation order: seed(0,0); bands r=2..ROWS (rows ROWS-1..1, col 0); then for
# every band row (0, ROWS-1..1) the columns c=2..COLS.
declare -a rows_seq=(0)
for ((r=2; r<=ROWS; r++)); do rows_seq+=($((ROWS - r + 1))); done

declare -a cmds=()
add_cell() { # row col
    local hi=$(( $1 * COLS + $2 ))
    cmds+=("$(cell_cmd "$hi")")
}
add_cell 0 0
for ((i=1; i<${#rows_seq[@]}; i++)); do add_cell "${rows_seq[i]}" 0; done
for rb in "${rows_seq[@]}"; do
    for ((c=2; c<=COLS; c++)); do add_cell "$rb" $((COLS - c + 1)); done
done

# advance the per-spawn command pointer.  NOT via $() substitution — that runs
# in a subshell and the increment would be lost.  Call next_cmd, then read $cur.
sp=0; cur=
next_cmd() { cur=${cmds[$sp]}; sp=$((sp+1)); }

# ---- build config: follow_mouse 0 + animations off; restore prior on exit ----
anim_prev=$(hyprctl -j getoption animations:enabled | jq -r '.bool')
fm_prev=$(hyprctl -j getoption input:follow_mouse | jq -r '.int')
restore_cfg() { hyprctl eval "hl.config({ input = { follow_mouse = $fm_prev }, animations = { enabled = $anim_prev } })" >/dev/null 2>&1; }
trap restore_cfg EXIT
hyprctl eval 'hl.config({ input = { follow_mouse = 0 }, animations = { enabled = false } })' >/dev/null

# ---- adaptive waits ----
wait_map() { # prev_total old_active
    local prev=$1 old=$2 expect=$((prev + 1)) i c a
    for ((i=0; i<300; i++)); do
        c=$(cnt)
        if (( c >= expect )); then
            a=$(hyprctl -j activewindow | jq -r '.address')
            [[ -n $a && $a != "$old" ]] && return 0
        fi
        sleep 0.005
    done
    echo "grid-ssh: window map timeout (expected #$expect)" >&2
    return 1
}
wait_stable() {
    local i a b
    for ((i=0; i<50; i++)); do
        a=$(act); sleep 0.03; b=$(act)
        [[ $a == "$b" ]] && return 0
    done
    echo "grid-ssh: geometry not stable" >&2
    return 1
}

adj() {
    local dim=$1 L=$2 R=$3 w h addr delta dpct
    read -r w h addr <<<"$(act)"
    dpct=$(awk -v L="$L" -v R="$R" 'BEGIN{printf "%.1f", (2*R/(L+R)-1)*100}')
    if awk -v d="$dpct" 'BEGIN{exit !(d < -0.5)}'; then
        if (( dim == 0 )); then
            delta=$(awk -v s="$w" -v d="$dpct" 'BEGIN{printf "%.0f", s*(-d)/100}')
            rr "$delta" 0
        else
            delta=$(awk -v s="$h" -v d="$dpct" 'BEGIN{printf "%.0f", s*(-d)/100}')
            rr 0 "$delta"
        fi
        wait_stable
    fi
}

# ---- seed (top-left cell) ----
prev=$(cnt)
next_cmd; ex; wait_map "$prev" ""
seed=$(hyprctl -j activewindow | jq -r '.address')
[[ $seed == null || -z $seed ]] && { echo "grid-ssh: no active window after seed spawn" >&2; exit 1; }

# ---- 1) ROWS equal full-width bands ----
bands=("$seed")
for ((r=2; r<=ROWS; r++)); do
    L=$((ROWS - r + 1)); R=1
    fa "$seed"; lm "preselect d"
    prev=$(cnt); next_cmd; ex; wait_map "$prev" "$seed"; wait_stable
    new=$(hyprctl -j activewindow | jq -r '.address')
    bands+=("$new")
    adj 1 "$L" "$R"
done

# ---- 2) within each band, COLS equal columns ----
for b in "${bands[@]}"; do
    for ((c=2; c<=COLS; c++)); do
        L=$((COLS - c + 1)); R=1
        fa "$b"; lm "preselect r"
        prev=$(cnt); next_cmd; ex; wait_map "$prev" "$b"; wait_stable
        adj 0 "$L" "$R"
    done
done
