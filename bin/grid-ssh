#!/usr/bin/env bash
# hypr-grid.sh – spawn one Alacritty-SSH terminal per host in a balanced grid
# usage:  hypr-grid.sh  host1 host2 …
# notes :  • hard-wired to workspace 9
#          • empty panes get a plain shell
#          • grid chosen to minimise |aspect-ratio – 16:9|, then empty tiles

############################################
# settings                                 #
############################################
#WS=9
TERMINAL=alacritty
DELAY=0.18                 # tune if windows map too slowly
TARGET_RATIO=1.7777778     # 16/9

RESERVED_LEFT=0
RESERVED_TOP=0
RESERVED_RIGHT=0
RESERVED_BOTTOM=0

die() {
    echo "grid-ssh: $*" >&2
    exit 1
}

load_reserved_area() {
    local monitor reserved

    command -v jq >/dev/null || die "jq is required"
    monitor=$(hyprctl -j activeworkspace | jq -r '.monitor')
    [[ -n $monitor && $monitor != null ]] || die "could not determine active monitor"

    reserved=$(hyprctl -j monitors \
        | jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | .reserved | @tsv')
    [[ -n $reserved ]] || die "could not read monitor reserved area for $monitor"

    read -r RESERVED_LEFT RESERVED_TOP RESERVED_RIGHT RESERVED_BOTTOM <<< "$reserved"
}

grid_rule() {
    local col=$1 row=$2
    local usable_w usable_h cell_w cell_h cell_x cell_y

    usable_w="(monitor_w-${RESERVED_LEFT}-${RESERVED_RIGHT})"
    usable_h="(monitor_h-${RESERVED_TOP}-${RESERVED_BOTTOM})"
    cell_w="(${usable_w}/${COLS})"
    cell_h="(${usable_h}/${ROWS})"
    cell_x="(${RESERVED_LEFT}+(${usable_w}*${col}/${COLS}))"
    cell_y="(${RESERVED_TOP}+(${usable_h}*${row}/${ROWS}))"

    printf '[float; size %s %s; move %s %s]' "$cell_w" "$cell_h" "$cell_x" "$cell_y"
}

############################################
# hosts from CLI                           #
############################################
HOSTS=("$@")
N=${#HOSTS[@]}
(( N == 0 )) && { echo "Usage: $0 host1 host2 …" >&2; exit 1; }

############################################
# choose COLS × ROWS                       #
############################################
best_diff=1e9
best_unused=1e9
ROWS=1
COLS=$N

for ((rows=1; rows<=N; rows++)); do
    cols=$(( (N + rows - 1) / rows ))          # ceil(N / rows)
    unused=$(( rows*cols - N ))
    ratio=$(awk -v c="$cols" -v r="$rows" 'BEGIN{print c/r}')
    diff=$(awk -v a="$ratio" -v b="$TARGET_RATIO" 'BEGIN{print (a>b?a-b:b-a)}')

    if  (( $(awk "BEGIN{print ($diff < $best_diff - 1e-6)}") )) || \
        { [[ "$diff" == "$best_diff" ]] && (( unused < best_unused )); }; then
        best_diff=$diff
        best_unused=$unused
        ROWS=$rows
        COLS=$cols
    fi
done

############################################
# helpers                                  #
############################################
spawn() {                                      # $1 = global index
    local col row host_q cmd

    col=$(($1 % COLS))
    row=$(($1 / COLS))

    if (( $1 < N )); then
        printf -v host_q '%q' "${HOSTS[$1]}"
        cmd="$TERMINAL --command ssh $host_q"
    else
        cmd="$TERMINAL"
    fi

    hyprctl dispatch exec "$(grid_rule "$col" "$row") $cmd"
}

############################################
# build grid                               #
############################################
#hyprctl dispatch workspace "$WS"
load_reserved_area

for ((idx=0; idx<COLS*ROWS; idx++)); do
    spawn "$idx"; sleep "$DELAY"
done
